<?xml version="1.0" encoding="utf-8"?>
<!--
  WaningOath - NuGet 配置

  本机到 nuget.org 不通，且全局没有 .NET SDK（只有工作目录内的 .dotnet）。
  Godot 的 .NET 包随编辑器一起分发在 GodotSharp\Tools\nupkgs，
  因此把它配成唯一包源：四个工程都能完全离线还原与构建。

  <clear /> 是刻意的：避免任何一次 restore 去碰外网而卡住或失败。
  将来若确实需要第三方包，在这里追加一个 <add> 即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="Godot4\Godot_v4.7.1-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
