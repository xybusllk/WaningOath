    "talent": {
      "id": "skill-bingyuan-bumie",
      "kind": "talent",
      "name": "冰原不灭的意志",
      "scalingArray": "none",
      "triggers": [
        {
          "_note": "① 未标记任何目标 ⇒ 行动结束 +1 无人机。",
