              "type": "conditional",
              "condition": "notStatus:燎原",
              "then": [
                {
                  "type": "spendStack",
                  "stack": "无人机",
                  "amount": 1,
                  "target": "self"
                },
                {
                  "type": "gainStack",
                  "stack": "意志",
                  "amount": 1,
                  "cap": 5,
                  "target": "self"
                },
                {
                  "_note": "权阶Ⅳ「赤潮的意志」：每消耗 1 架无人机，全队火属性伤害 +3%（2 回合，最多 3 层）。闸门读 `dmgBonusFire`；状态本身可叠 3 层。",
                  "type": "conditional",
                  "condition": "knobAtLeast:dmgBonusFire:0.001",
                  "then": [
                    {
                      "type": "applyBuff",
                      "buffId": "buff-red-tide-will",
                      "stacks": 1,
                      "duration": 2,
                      "target": "partyAll",
                      "stackCounter": "perAttack"
                    }
                  ]
                },
                {
                  "_note": "权阶Ⅵ「燎原的黎明」：协同攻击消耗无人机时 50% 返还 1 架。概率从 `droneRefundChance` 旋钮读，不在数据里抄第二遍。",
                  "type": "conditional",
                  "condition": "knobAtLeast:droneRefundChance:0.01",
                  "then": [
                    {
                      "type": "chanceCheck",
                      "chanceKnob": "droneRefundChance",
                      "onSuccess": [
                        {
                          "type": "gainStack",
                          "stack": "无人机",
                          "amount": 1,
                          "cap": 6,
                          "target": "self"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "additionalDamage",
              "element": "fire",
              "multiplier": 0.6,
              "target": "mainTarget",
              "knob": "droneDamageBonus",
              "accumulateAnomaly": true,
              "canCrit": true
